{
  "schemaVersion": 1,
  "id": "orbital_railgun",
  "version": "${version}",
  "name": "Railguns+",
  "description": "Railguns+: call down orbital railguns with a two-handed uplink tablet. ARES-9 fires, scans and tears rifts into real space; ARES-0 destroys planets. Fly an EVA jetpack to the Moon, Mars, Venus and Europa. Requires Immersive Portals.",
  "authors": [
    "CreedPDF"
  ],
  "contact": {
    "sources": "https://github.com/CreedPDF/Railguns-"
  },
  "license": "MIT",
  "icon": "assets/orbital_railgun/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.creedpdf.orbitalrailgun.RailgunMod"
    ],
    "client": [
      "com.creedpdf.orbitalrailgun.client.RailgunModClient"
    ],
    "modmenu": [
      "com.creedpdf.orbitalrailgun.client.config.ModMenuEntry"
    ]
  },
  "accessWidener": "orbital_railgun.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "geckolib": ">=4.2 <4.5",
    "imm_ptl_core": "*",
    "q_misc_util": "*"
  },
  "mixins": [
    "orbital_railgun.mixins.json",
    {
      "config": "orbital_railgun.client.mixins.json",
      "environment": "client"
    }
  ]
}